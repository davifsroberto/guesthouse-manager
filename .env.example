# Copie este arquivo para .env e preencha com os dados do seu projeto Supabase
# (Supabase > Project Settings > API). Use a chave "anon public", NUNCA a "service_role".
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=sua-chave-anon-public

# Login de demonstração (opcional): mostra o botão "Entrar como demonstração".
# O usuário precisa existir no Supabase (rode supabase/usuario-demo.sql com a mesma senha).
# ATENÇÃO: esses valores ficam visíveis no código do site publicado. Use só com dados fictícios.
DEMO_EMAIL=demo@pousocurral.com
DEMO_PASSWORD=
